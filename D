// ======== UTILITIES ========
const rupee = (n) => new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 }).format(n);
const pct = (n) => `${(n * 100).toFixed(1)}%`;
const classNames = (...c) => c.filter(Boolean).join(" ");

// CAGR utility from an equity curve
function calcCAGR(series) {
  if (!series?.length) return 0;
  const start = series[0].value;
  const end = series[series.length - 1].value;
  const days = (new Date(series[series.length - 1].date) - new Date(series[0].date)) / (1000 * 60 * 60 * 24);
  const years = Math.max(days / 365, 0.01);
  return Math.pow(end / start, 1 / years) - 1;
}

// Compute hit-rate & avg returns
function performanceStats(trades) {
  if (!trades?.length) return { hit: 0, avgGain: 0, avgLoss: 0, pfReturn: 0 };
  const gains = trades.filter(t => t.pctReturn > 0).map(t => t.pctReturn);
  const losses = trades.filter(t => t.pctReturn <= 0).map(t => t.pctReturn);
  const hit = gains.length / trades.length;
  const avgGain = gains.length ? gains.reduce((a,b)=>a+b,0)/gains.length : 0;
  const avgLoss = losses.length ? losses.reduce((a,b)=>a+b,0)/losses.length : 0;
  const pfReturn = trades.reduce((a,t)=> a * (1 + t.pctReturn), 1) - 1;
  return { hit, avgGain, avgLoss, pfReturn };
}

