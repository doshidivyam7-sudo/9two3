// Stock Research Copilot — Database Schema
// PostgreSQL via Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  watchlists      Watchlist[]
  portfolios      Portfolio[]
  theses          InvestmentThesis[]
  researchReports ResearchReport[]
  researchNotes   ResearchNote[]
  uploadedDocs    UploadedDocument[]
  aiConversations AIConversation[]
  apiKeys         UserApiKey[]
  preferences     UserPreferences?

  @@index([email])
}

enum UserRole {
  USER
  ANALYST
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPreferences {
  id              String  @id @default(cuid())
  userId          String  @unique
  llmProvider     String  @default("anthropic")
  defaultExchange String  @default("NSE")
  baseCurrency    String  @default("INR")
  theme           String  @default("dark")
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserApiKey {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  // Encrypted in app layer
  keyCipher String   @db.Text
  label     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, label])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Securities Universe
// ---------------------------------------------------------------------------

model Company {
  id          String  @id @default(cuid())
  // NSE ticker without ".NS" — e.g. RELIANCE, TCS, HUDCO, INOXINDIA
  ticker      String  @unique
  bseCode     String? @unique
  isin        String? @unique
  name        String
  legalName   String?
  sector      String?
  industry    String?
  description String? @db.Text
  website     String?
  // INR Cr
  marketCapCr Float?
  exchange    String  @default("NSE")
  currency    String  @default("INR")
  country     String  @default("IN")
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  financials    FinancialStatement[]
  ratios        FinancialRatio[]
  segments      RevenueSegment[]
  reports       ResearchReport[]
  watchlistItems WatchlistItem[]
  portfolioHoldings PortfolioHolding[]
  theses        InvestmentThesis[]
  news          NewsItem[]
  documents     UploadedDocument[]
  peers         CompanyPeer[]      @relation("CompanyToPeers")
  peerOf        CompanyPeer[]      @relation("PeerToCompany")

  @@index([sector])
  @@index([industry])
  @@index([name])
}

model CompanyPeer {
  id        String  @id @default(cuid())
  companyId String
  peerId    String
  rank      Int     @default(0)

  company Company @relation("CompanyToPeers", fields: [companyId], references: [id], onDelete: Cascade)
  peer    Company @relation("PeerToCompany", fields: [peerId], references: [id], onDelete: Cascade)

  @@unique([companyId, peerId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Financials
// ---------------------------------------------------------------------------

enum StatementType {
  INCOME
  BALANCE
  CASHFLOW
}

enum Period {
  ANNUAL
  QUARTERLY
}

model FinancialStatement {
  id          String        @id @default(cuid())
  companyId   String
  type        StatementType
  period      Period
  fiscalYear  Int
  fiscalQuarter Int?
  // ISO date of period end
  endDate     DateTime
  reportedAt  DateTime?
  currency    String        @default("INR")
  // INR Cr by convention
  unit        String        @default("CR")
  // Free-form line items so we don't have to change schema for new metrics
  lineItems   Json
  source      String?
  createdAt   DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, period, fiscalYear, fiscalQuarter])
  @@index([companyId, period, fiscalYear])
}

model FinancialRatio {
  id          String   @id @default(cuid())
  companyId   String
  period      Period
  fiscalYear  Int
  fiscalQuarter Int?

  revenueCr   Float?
  ebitdaCr    Float?
  ebitCr      Float?
  patCr       Float?
  cfoCr       Float?
  fcfCr       Float?
  capexCr     Float?

  grossMargin Float?
  ebitdaMargin Float?
  patMargin   Float?
  roce        Float?
  roe         Float?
  roa         Float?

  debtCr      Float?
  cashCr      Float?
  netDebtCr   Float?
  debtToEquity Float?
  interestCoverage Float?

  receivableDays Float?
  payableDays    Float?
  inventoryDays  Float?
  cashConversionDays Float?

  pe          Float?
  evEbitda    Float?
  evSales     Float?
  pb          Float?
  dividendYield Float?

  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, period, fiscalYear, fiscalQuarter])
  @@index([companyId, fiscalYear])
}

model RevenueSegment {
  id         String @id @default(cuid())
  companyId  String
  fiscalYear Int
  segment    String
  revenueCr  Float
  pctOfTotal Float?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, fiscalYear])
}

// ---------------------------------------------------------------------------
// Research
// ---------------------------------------------------------------------------

enum ResearchKind {
  FULL_REPORT
  EARNINGS_NOTE
  THESIS_UPDATE
  RISK_REVIEW
}

model ResearchReport {
  id        String       @id @default(cuid())
  userId    String
  companyId String
  kind      ResearchKind @default(FULL_REPORT)
  title     String
  summary   String?      @db.Text
  // Structured report body produced by the agent orchestrator
  body      Json
  // Snapshot of company state at time of generation (price, valuation, ratios)
  snapshot  Json?
  model     String?
  status    String       @default("READY")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
}

model ResearchNote {
  id        String   @id @default(cuid())
  userId    String
  ticker    String?
  title     String
  body      String   @db.Text
  tags      String[]
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticker])
}

// ---------------------------------------------------------------------------
// Watchlist & Portfolio
// ---------------------------------------------------------------------------

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@unique([userId, name])
}

model WatchlistItem {
  id            String   @id @default(cuid())
  watchlistId   String
  companyId     String
  targetPrice   Float?
  stopPrice     Float?
  thesisShort   String?  @db.Text
  addedAt       DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, companyId])
}

model Portfolio {
  id        String   @id @default(cuid())
  userId    String
  name      String
  baseCurrency String @default("INR")
  createdAt DateTime @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings PortfolioHolding[]

  @@unique([userId, name])
}

model PortfolioHolding {
  id          String   @id @default(cuid())
  portfolioId String
  companyId   String
  quantity    Float
  avgCost     Float
  addedAt     DateTime @default(now())
  notes       String?  @db.Text

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, companyId])
}

// ---------------------------------------------------------------------------
// Investment Thesis & Thesis Monitor™
// ---------------------------------------------------------------------------

enum ThesisStatus {
  ACTIVE
  STRENGTHENED
  WEAKENED
  BROKEN
  EXITED
}

enum Conviction {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

model InvestmentThesis {
  id            String        @id @default(cuid())
  userId        String
  companyId     String
  title         String
  thesis        String        @db.Text
  // Structured list of falsifiable lead indicators the monitor watches
  leadIndicators Json
  bullCase      String?       @db.Text
  baseCase      String?       @db.Text
  bearCase      String?       @db.Text
  targetPrice   Float?
  stopLoss      Float?
  timeHorizonMonths Int       @default(36)
  conviction    Conviction    @default(MEDIUM)
  status        ThesisStatus  @default(ACTIVE)
  lastMonitoredAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  checks  ThesisCheck[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

enum ThesisVerdict {
  STRENGTHENED
  INTACT
  WEAKENED
  BROKEN
}

model ThesisCheck {
  id        String        @id @default(cuid())
  thesisId  String
  verdict   ThesisVerdict
  score     Float
  reasoning String        @db.Text
  // Evidence pulled in by the monitor — news, filings, concall snippets
  evidence  Json
  model     String?
  createdAt DateTime      @default(now())

  thesis InvestmentThesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  @@index([thesisId, createdAt])
}

// ---------------------------------------------------------------------------
// News & Documents
// ---------------------------------------------------------------------------

model NewsItem {
  id         String   @id @default(cuid())
  companyId  String?
  ticker     String?
  headline   String
  url        String?
  source     String?
  publishedAt DateTime
  sentiment  Float?
  summary    String?  @db.Text
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, publishedAt])
  @@index([ticker, publishedAt])
}

enum DocumentKind {
  ANNUAL_REPORT
  CONCALL_TRANSCRIPT
  INVESTOR_PRESENTATION
  EARNINGS_RELEASE
  RESEARCH_NOTE
  OTHER
}

model UploadedDocument {
  id         String       @id @default(cuid())
  userId     String
  companyId  String?
  kind       DocumentKind @default(OTHER)
  title      String
  fileName   String
  fileSize   Int
  mimeType   String
  storageUrl String?
  // Extracted plain text for retrieval / agent context
  text       String?      @db.Text
  summary    String?      @db.Text
  metadata   Json?
  createdAt  DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// AI Conversations
// ---------------------------------------------------------------------------

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  ticker    String?
  title     String?
  agent     String   @default("research")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id              String   @id @default(cuid())
  conversationId  String
  role            String
  content         String   @db.Text
  toolCalls       Json?
  tokensIn        Int?
  tokensOut       Int?
  createdAt       DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
