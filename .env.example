# ---------- Database ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_research_copilot?schema=public"

# ---------- Auth.js ----------
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ---------- AI Providers ----------
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Which LLM provider to use as default agent runtime: "anthropic" | "openai"
LLM_PROVIDER="anthropic"
ANTHROPIC_MODEL="claude-opus-4-7"
OPENAI_MODEL="gpt-4o"

# ---------- Market Data Providers ----------
# Choose: "mock" | "fmp" | "alphavantage" | "polygon"
MARKET_DATA_PROVIDER="mock"

FMP_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
POLYGON_API_KEY=""

# Optional NSE/BSE proxy (if you proxy NSE/BSE through your own service)
NSE_API_BASE_URL=""
BSE_API_BASE_URL=""

# ---------- App ----------
NEXT_PUBLIC_APP_NAME="Stock Research Copilot"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
